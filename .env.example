# =============================================================================
# MaxKB MCP Server — environment configuration template
# -----------------------------------------------------------------------------
# Usage:
#   1. cp .env.example .env          (Windows: copy .env.example .env)
#   2. Edit .env and fill in real values
#   3. docker compose up -d --build
#
# Security:
#   * .env is git-ignored. NEVER commit it; keep placeholders only in this file.
#   * Wrap values containing spaces or punctuation in double quotes.
#   * An empty optional value = the program's built-in default (noted per item).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Global
# -----------------------------------------------------------------------------

# [REQUIRED] MaxKB base URL — scheme + host + port only, no trailing slash,
# and NO application id.
#   Correct: http://192.168.1.100:8080
#   Wrong:   http://192.168.1.100:8080/chat/api/<app-id>   <- that is the web
#            embed URL meant for browsers; using it here 404s every call.
# Which agent you talk to is decided by CHAT_API_KEY, never by this URL.
MAXKB_BASE_URL=http://REPLACE_WITH_YOUR_MAXKB_HOST:8080

# [optional] pip index used while building images.
# Default is the Tsinghua mirror (good in CN); use https://pypi.org/simple elsewhere.
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# [optional] Access token for the MCP endpoints. When set, every request to
# /mcp, /sse and /messages must carry: Authorization: Bearer <this value>.
# Empty = no check (trusted internal network only). Shared by both services.
MCP_AUTH_TOKEN=

# [optional] Comma-separated allow-list of HTTP Host header values (DNS
# rebinding protection). Empty = "*" = protection disabled.
# Note: this validates the request's Host header, NOT the client IP.
# "10.0.0.5:18010" and "127.0.0.1:18010" are different entries; a wrong value
# fails with HTTP 421.
MCP_ALLOWED_HOSTS=

# -----------------------------------------------------------------------------
# 2. Service 1 — agent chat (maxkb-chat-mcp)
# -----------------------------------------------------------------------------

# [optional] Host port mapping; the container side is fixed at 8000. Default 18010.
CHAT_PORT=18010

# [REQUIRED unless you use CHAT_AGENTS] Application API key of ONE MaxKB agent.
# Get it in: MaxKB console -> App -> Publish / Settings -> API Key.
# Prefix is agent-xxxx on v2.10+, application-xxxx on older builds.
# This single value decides which agent the tool talks to: one key = one app.
# The server reverse-looks-up the application id, so never put an app id here.
# To switch agents, change this value.
CHAT_API_KEY=REPLACE_WITH_YOUR_APP_API_KEY

# [optional] Serve multiple agents from ONE process — no extra containers.
# Format: tool_name:app_api_key[:description] , entries separated by |
#   - a description may contain colons (only the first two fields are split);
#     do not use | inside a description
#   - tool_name should be ASCII (letters / digits / _ / - / .) and must not
#     duplicate CHAT_TOOL_NAME
#   - each agent keeps its own conversation (chat_id); contexts never mix
#   - may coexist with CHAT_API_KEY above (that one becomes CHAT_TOOL_NAME)
# Example:
# CHAT_AGENTS=ops_chat:agent-xxxxxxxx:Senior ops expert for VMware and ZStack questions|crm_chat:agent-yyyyyyyy:CRM assistant
CHAT_AGENTS=

# [optional] Server name shown to MCP clients.
CHAT_SERVER_NAME="MaxKB Agent Chat MCP Server"

# [optional] Tool name for the single-agent mode. Default maxkb_chat.
CHAT_TOOL_NAME=maxkb_chat

# [optional] Tool description — tells the calling AI when to use this tool.
# Tip: start it with an English verb followed by a space. UIs such as LiteLLM
# classify tools by word-bounded English verbs, so a Chinese-only description
# lands in "Other / uncategorized".
CHAT_TOOL_DESCRIPTION="Ask and get answers from the MaxKB agent. Multi-turn conversation context is kept automatically."

# [optional] Timeout in seconds for MaxKB chat calls. Raise it for slow agents.
CHAT_TIMEOUT=180

# [optional/advanced] MaxKB chat API path prefix. Default /chat. Leave empty
# unless MaxKB sits behind a proxy that rewrites paths.
MAXKB_CHAT_PREFIX=

# -----------------------------------------------------------------------------
# 3. Service 2 — knowledge base (maxkb-knowledge-mcp)
# -----------------------------------------------------------------------------

# [optional] Host port mapping. Default 18011.
KB_PORT=18011

# ---- [REQUIRED] Admin-side credential — choose ONE method ----
# Method A (recommended): user-level API key.
#   Create it in MaxKB: top-right avatar -> API Keys. Takes precedence when set.
KB_API_KEY=

# Method B: admin username + password (used only when KB_API_KEY is empty).
#   The service logs in through /admin/api/user/login, caches the JWT and
#   re-logins automatically on 401.
KB_USERNAME=admin
KB_PASSWORD=

# [optional] Workspace id. Empty = auto-detect from the user profile
# (community edition is usually "default").
KB_WORKSPACE_ID=

# [optional but strongly recommended] Default knowledge base id, used whenever a
# tool call omits knowledge_base_id. Without it search_knowledge reports
# "knowledge base not specified". List ids with the list_knowledge_bases tool.
KB_KNOWLEDGE_ID=

# [optional] Server name shown to MCP clients.
KB_SERVER_NAME="MaxKB Knowledge Base MCP Server"

# [optional] Default number of segments returned by search_knowledge. Default 5.
KB_TOP_NUMBER=5

# [optional] Default similarity threshold (0~1). Default 0.6.
KB_SIMILARITY=0.6

# [optional] Default retrieval mode — English enum only:
#   embedding (vector) | keywords | blend (hybrid, default)
# Tool arguments may pass other spellings; they are normalized automatically,
# but this default itself must be one of the three English words.
KB_SEARCH_MODE=blend

# [optional] get_segment_context: how many segments to extend before and after
# the matched one by default. Suggest 1~3. Default 1.
KB_CONTEXT_NEIGHBORS=1

# [optional] get_segment_context: character cap per call, which guards against
# token blow-ups. When hit, the output states the result is incomplete instead
# of truncating silently. Default 6000.
KB_CONTEXT_MAX_CHARS=6000

# [optional] Timeout in seconds for admin API calls. Default 120.
KB_TIMEOUT=120

# [optional/advanced] Admin API path prefix. Default /admin.
MAXKB_ADMIN_PREFIX=
