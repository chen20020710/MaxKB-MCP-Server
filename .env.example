# =============================================================================
# MaxKB MCP Server — 环境变量配置模板
# -----------------------------------------------------------------------------
# 使用方法:
#   1. cp .env.example .env     (Windows: copy .env.example .env)
#   2. 编辑 .env, 把下面所有 REPLACE / 空的必填项换成你的真实值
#   3. docker compose up -d --build
#
# 安全须知:
#   * .env 已被 .gitignore 忽略, 严禁提交到 Git 仓库。
#   * 本文件只是模板, 请只在此文件中保留占位符, 真实密码只写在 .env 里。
#   * 若需要给 MCP 端点加访问控制, 请设置 MCP_AUTH_TOKEN, 并在客户端
#     请求头中携带 Authorization: Bearer <该值>。
#
# 语法提示:
#   * 值中若含空格、中文标点或 # 等特殊字符, 请用双引号包裹(下方示例已用)。
#   * 留空的变量 = 使用程序内置默认值(见每项说明)。
# =============================================================================

# -----------------------------------------------------------------------------
# 一、全局 / 公共配置
# -----------------------------------------------------------------------------

# [必填] MaxKB 服务【根地址】, 只填到端口为止, 末尾不要带 /。
# 正确: http://192.168.1.100:8080
# 错误: http://192.168.1.100:8080/chat/api/<应用ID>
#       (那是前端嵌入用的应用专属访问地址, 服务会再拼一次 /chat/api/open 导致 404)
#
# 问: 那要调用哪个智能体(应用)怎么指定? 需要在这里填应用 ID 吗?
# 答: 不需要! 应用完全由下面的 CHAT_API_KEY 决定 —— MaxKB 是「一应用一密钥」,
#     服务端会用这个 Key 反查 application_id, 无需在 URL 或配置里出现应用 ID。
MAXKB_BASE_URL=http://REPLACE_WITH_YOUR_MAXKB_HOST:8080

# [可选] pip 镜像源, 用于构建镜像时安装依赖。
# 国内网络默认清华源; 海外或可直连 PyPI 时改为 https://pypi.org/simple
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# [可选] MCP 端点访问令牌。设置后, 访问 /mcp、/sse、/messages 都必须携带
# Authorization: Bearer <MCP_AUTH_TOKEN>。留空 = 不校验(仅限内网可信环境)。
# 两个服务共用同一个值。
MCP_AUTH_TOKEN=

# [可选] Host 头白名单, 逗号分隔, 用于防止 DNS rebinding 攻击。
# 留空时程序默认为 * (不校验)。收紧示例: "your-host:18010,your-host:18011"
MCP_ALLOWED_HOSTS=


# -----------------------------------------------------------------------------
# 二、服务 1: 智能体对话 MCP 服务器 (maxkb-chat-mcp)
# -----------------------------------------------------------------------------

# [可选] 映射到宿主机的端口, 容器内固定 8000。默认 18010。
CHAT_PORT=18010

# [必填] MaxKB【应用级】API Key —— 这一项就决定了调用哪个智能体。
#
# 获取步骤: MaxKB 控制台 -> 应用列表 -> 进入目标应用 -> 「设置 / 发布」页
#           -> 开启 API 访问 -> 复制该应用的 API Key。
# 注意: 这是「应用 API Key」, 不是下面 KB_API_KEY 的「用户级 API Key」, 两者不能混用。
# 不同版本前缀不同: v2.10+ 多为 agent-xxxxxxxx, 旧版为 application-xxxxxxxx,
# 以页面上实际复制到的字符串为准, 整串填入。
#
# 想换一个智能体? 把这里换成那个应用的 API Key, 然后 docker compose up -d 即可。
# 想同时暴露多个智能体? 在 docker-compose.yml 里复制一份 chat 服务,
# 分别配不同的 API_KEY / TOOL_NAME / 宿主端口(详见 README 第三节)。
CHAT_API_KEY=REPLACE_WITH_YOUR_APP_API_KEY

# [可选] MCP 服务器名称(展示给客户端)。留空 = "MaxKB 智能体对话 MCP 服务器"
CHAT_SERVER_NAME="MaxKB 智能体对话 MCP 服务器"

# [可选] 对外暴露的工具名。留空 = maxkb_chat
CHAT_TOOL_NAME=maxkb_chat

# [可选] 工具描述, 会展示给调用方 AI, 决定它何时调用本工具。
# 建议写清楚这个智能体能回答什么问题; 开头带 search/get 等英文动词有助于
# LiteLLM 等平台把它自动归类为「读」类工具(否则会显示 Other/未分类)。
CHAT_TOOL_DESCRIPTION="Send a message and get the answer from the MaxKB agent. 向 MaxKB 智能体提问并获取回答, 支持多轮对话上下文。"

# [可选] 调用 MaxKB 对话接口的超时(秒), 智能体回答慢可调大。留空 = 180
CHAT_TIMEOUT=180

# [可选/高级] MaxKB 聊天 API 前缀, 一般无需修改。留空 = /chat
MAXKB_CHAT_PREFIX=


# -----------------------------------------------------------------------------
# 三、服务 2: 知识库管理 MCP 服务器 (maxkb-knowledge-mcp)
# -----------------------------------------------------------------------------

# [可选] 映射到宿主机的端口, 容器内固定 8000。默认 18011。
KB_PORT=18011

# ---- [必填] 管理端凭据: 下面两种方式二选一 ----
# 方式 A(推荐): 用户级 API Key。
#   在 MaxKB 页面右上角头像 -> 「API Key 管理」创建, 整串填入。
#   填入后优先使用, KB_USERNAME/KB_PASSWORD 会被忽略。
KB_API_KEY=

# 方式 B: 管理员账号 + 密码登录(仅当 KB_API_KEY 留空时生效)。
#   服务会自动调用 /admin/api/user/login 换取 JWT, 并在 401 时自动重登。
KB_USERNAME=admin
KB_PASSWORD=

# [可选] 工作空间 ID。留空 = 自动从用户 profile 获取(社区版通常为 default)。
KB_WORKSPACE_ID=

# [可选但强烈建议配置] 默认知识库 ID。
# 工具未显式传 knowledge_base_id 时使用它。不配置的话, 直接调用
# search_knowledge 会返回「未指定知识库」。
# 获取方式: 启动后调用 list_knowledge_bases 工具查询, 或从 MaxKB 知识库页面 URL 中获取。
KB_KNOWLEDGE_ID=

# [可选] MCP 服务器名称。留空 = "MaxKB 知识库管理 MCP 服务器"
KB_SERVER_NAME="MaxKB 知识库管理 MCP 服务器"

# [可选] 检索默认返回条数。留空 = 5
KB_TOP_NUMBER=5

# [可选] 检索默认相似度阈值(0~1)。留空 = 0.6
KB_SIMILARITY=0.6

# [可选] 检索默认模式, 只能是以下三个英文值之一:
#   embedding(向量) | keywords(关键字) | blend(混合, 默认)
# 注意: 工具入参允许传「嵌入/关键字/混合」等中文或别名, 服务会自动归一化,
#       但这里配置默认值时请务必用英文枚举值。
KB_SEARCH_MODE=blend

# [可选] 调用 MaxKB 管理端接口的超时(秒)。留空 = 120
KB_TIMEOUT=120

# [可选/高级] MaxKB 管理端 API 前缀, 一般无需修改。留空 = /admin
MAXKB_ADMIN_PREFIX=
